---
import { storyblokEditable, renderRichText } from '@storyblok/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroField from '../components/HeroField.astro';
import { getStory } from '../lib/storyblok';

const story = await getStory('auto-insights');
const content = story?.content ?? {};

const heroEyebrow = content.hero_eyebrow ?? 'Auto Insights';
const heroHeading = content.hero_heading ?? 'De-anonymize 50% of daily website traffic';
const heroSubheading =
	content.hero_subheading ??
	'Two percent of your visitors fill out a form. Auto Insights lets you talk to half of them.';
const bodySections = content.body ?? [];

const defaultStats = [
	{ number: '50%', label: 'of daily traffic identified' },
	{ number: '3+', label: 'emails per visitor' },
	{ number: '30%', label: 'more website leads' },
	{ number: '15.3%', label: 'average close rate' },
];
const stats = content.stats?.length ? content.stats : defaultStats;

const ctaHeading = content.cta_heading ?? 'Schedule a 20 Minute Demo Today';
const ctaSubheading = content.cta_subheading ?? 'Name, email, dealership, and what you want to fix.';

const fallbackSteps = [
	{
		heading: 'Identify the visitor',
		body: 'A single tag on your existing site matches anonymous sessions against our database of in-market consumers. No change to your website provider.',
		pending: true,
	},
	{
		heading: 'Engage with 3+ emails',
		body: 'Every identified shopper enters a sequence built around what they looked at - sales or service. Email and direct mail are handled as part of Auto Insights, not a separate product.',
	},
	{
		heading: 'Convert on site',
		body: 'The offer engine reads shopper intent and presents the right offer to down-funnel visitors before they leave.',
	},
	{
		heading: 'Measure the lift',
		body: 'Reporting compares 1st party lead volume and close rate before and after. The 30% increase is the floor we commit to.',
	},
];

const differentiatorsEyebrow = content.differentiators_eyebrow ?? 'Why Auto Insights';
const differentiatorsHeading =
	content.differentiators_heading ?? "Built different from every other identity solution";

const defaultDifferentiators = [
	{
		heading: 'Build a database that you own',
		body: "Most providers never show you their marketing lists. We show you exactly who's visiting your website.",
	},
	{
		heading: 'True conquest',
		body: 'We address shoppers who have never done business with your dealership. Other solutions can only show previous customers.',
	},
	{
		heading: 'Not an IP or cookie-based solution',
		body: 'Those approaches are legally questionable and inaccurate. We create a double opt-in from each website visitor, so our lists are fully marketable and compliant.',
	},
	{
		heading: "Doesn't require access to your dealership databases",
		body: "Our program doesn't require DMS or CRM feeds.",
	},
	{
		heading: 'Transparent results',
		body: 'An end-to-end solution where the result is high-closing leads delivered to your CRM.',
	},
];
const differentiators = content.differentiators?.length ? content.differentiators : defaultDifferentiators;
---

<BaseLayout
	title="Auto Insights"
	description="Auto Insights de-anonymizes dealership website traffic and converts it into high-closing leads with targeted email engagement."
>
	<section class="hero hero--product">
		<HeroField variant="product" />
		<div class="wrap hero--product__inner">
			<p class="eyebrow">{heroEyebrow}</p>
			<h1>{heroHeading}</h1>
			<p class="hero__sub">{heroSubheading}</p>
		</div>
	</section>

	<section class="stats-section">
		<div class="wrap">
			<div class="stat-bar">
				{
					stats.map((stat) => (
						<div class="stat-bar__item">
							<p class="stat-bar__num">{stat.number}</p>
							<p class="stat-bar__label">{stat.label}</p>
						</div>
					))
				}
			</div>

			<div class="step-rows">
				{
					bodySections.length > 0 ? (
						bodySections.map((blok) => (
							<div class="step-row" {...storyblokEditable(blok)}>
								<span class="step-row__marker" aria-hidden="true" />
								{blok.heading && <h3>{blok.heading}</h3>}
								<div class="step-row__body">
									{blok.body ? (
										<Fragment set:html={renderRichText(blok.body)} />
									) : (
										<p class="placeholder-copy">[AUTO INSIGHTS SECTION COPY PENDING]</p>
									)}
								</div>
							</div>
						))
					) : (
						fallbackSteps.map((step, i) => (
							<div class="step-row">
								<p class="step-row__num">{String(i + 1).padStart(2, '0')}</p>
								<h3>{step.heading}</h3>
								<div class="step-row__body">
									<p>
										{step.body} {step.pending && <span class="placeholder-copy">[AUTO INSIGHTS COPY PENDING]</span>}
									</p>
								</div>
							</div>
						))
					)
				}
			</div>
		</div>
	</section>

	<section class="differentiators">
		<div class="wrap">
			<p class="eyebrow eyebrow-deep">{differentiatorsEyebrow}</p>
			<h2>{differentiatorsHeading}</h2>

			<div class="differentiator-grid">
				{
					differentiators.map((item) => (
						<div class="differentiator-card">
							<h3>{item.heading}</h3>
							<p>{item.body}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="cta-band">
		<div class="wrap cta-band__inner">
			<div>
				<h3>{ctaHeading}</h3>
				<p>{ctaSubheading}</p>
			</div>
			<a class="btn btn-primary" href="/contact">Schedule Demo</a>
		</div>
	</section>
</BaseLayout>

<style>
	.hero--product {
		position: relative;
		overflow: hidden;
		background: var(--serv-ink);
		color: var(--serv-off);
		padding-block: clamp(3.5rem, 6vw, 5rem) clamp(3.5rem, 6vw, 4.25rem);
	}

	.hero--product__inner {
		position: relative;
		z-index: 2;
		max-width: 860px;
	}

	.hero--product h1 {
		font-size: clamp(2rem, 1.05rem + 4.2vw, 3.375rem);
		line-height: 1.06;
		letter-spacing: -0.03em;
		color: var(--serv-off);
		margin: 0;
	}

	.hero__sub {
		font-size: clamp(1rem, 0.85rem + 0.5vw, 1.125rem);
		max-width: 56ch;
		color: var(--serv-text-muted-on-dark);
		margin: 1.5rem 0 0;
	}

	.stats-section {
		background: var(--serv-off);
		padding-bottom: clamp(3rem, 5vw, 4.75rem);
	}

	.stat-bar {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1px;
		background: var(--serv-border-on-light-strong);
		border: 1px solid var(--serv-border-on-light-strong);
		margin-top: -2rem;
		position: relative;
		z-index: 3;
	}

	.stat-bar__item {
		background: #fff;
		padding: 1.625rem;
	}

	.stat-bar__num {
		font-size: 1.875rem;
		font-weight: 600;
		letter-spacing: -0.02em;
		color: var(--serv-primary-deep);
		margin: 0;
	}

	.stat-bar__label {
		margin: 0.5rem 0 0;
		font-size: 0.813rem;
		line-height: 1.45;
		color: var(--serv-text-muted-on-light);
	}

	.step-rows {
		margin-top: 1.5rem;
	}

	@media (max-width: 700px) {
		.stat-bar {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 420px) {
		.stat-bar {
			grid-template-columns: 1fr;
		}
	}

	.differentiators {
		background: #fff;
		border-top: 1px solid var(--serv-border-on-light);
		padding-block: clamp(3rem, 5vw, 4.75rem);
	}

	.differentiators h2 {
		font-size: clamp(1.75rem, 1.2rem + 2.4vw, 2.5rem);
		letter-spacing: -0.02em;
		color: var(--serv-ink);
		max-width: 34ch;
		margin: 0.625rem 0 2.5rem;
	}

	.differentiator-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
	}

	.differentiator-card {
		border: 1px solid var(--serv-border-on-light);
		padding: 1.75rem 1.625rem;
	}

	.differentiator-card h3 {
		font-size: 1.06rem;
		line-height: 1.35;
		color: var(--serv-ink);
		margin: 0 0 0.625rem;
	}

	.differentiator-card p {
		font-size: 0.9rem;
		line-height: 1.6;
		color: var(--serv-text-muted-on-light);
		margin: 0;
	}

	@media (max-width: 900px) {
		.differentiator-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 560px) {
		.differentiator-grid {
			grid-template-columns: 1fr;
		}
	}

	.cta-band {
		background: var(--serv-ink);
		color: var(--serv-off);
		padding-block: clamp(2.5rem, 4vw, 3.75rem);
	}

	.cta-band__inner {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 2.5rem;
		flex-wrap: wrap;
	}

	.cta-band__inner h3 {
		color: var(--serv-off);
		font-size: clamp(1.375rem, 1.1rem + 1vw, 1.75rem);
		letter-spacing: -0.02em;
		margin: 0 0 0.625rem;
	}

	.cta-band__inner p {
		color: var(--serv-text-muted-on-dark);
		margin: 0;
		font-size: 0.94rem;
	}
</style>
