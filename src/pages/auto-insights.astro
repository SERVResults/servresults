---
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getStory } from '../lib/storyblok';

const story = await getStory('auto-insights');
const heroSubheading = story?.content?.hero_subheading;
const bodySections = story?.content?.body ?? [];
---

<BaseLayout
	title="Auto Insights"
	description="Auto Insights de-anonymizes dealership website traffic and converts it into high-closing leads with targeted email engagement."
>
	<section class="section hero">
		<div class="hero-glow" aria-hidden="true"></div>
		<div class="section-inner hero-inner">
			<p class="eyebrow">Flagship Product</p>
			<h1>Auto Insights</h1>
			{
				heroSubheading ? (
					<p class="hero-sub">{heroSubheading}</p>
				) : (
					<p class="hero-sub placeholder-copy">[AUTO INSIGHTS HERO COPY PENDING — managed in Storyblok]</p>
				)
			}
			<a class="btn btn-primary" href="/contact">Book a Demo</a>
		</div>
	</section>

	<section class="section body-copy">
		<div class="section-inner reveal">
			{
				bodySections.length > 0 ? (
					bodySections.map((blok) => <StoryblokComponent blok={blok} />)
				) : (
					<>
						<div class="body-block">
							<h2>Unified dealership data</h2>
							<p class="placeholder-copy">[AUTO INSIGHTS DATA CAPABILITIES COPY PENDING — managed in Storyblok]</p>
						</div>
						<div class="body-block">
							<h2>Precision audience targeting</h2>
							<p class="placeholder-copy">[AUTO INSIGHTS TARGETING COPY PENDING — managed in Storyblok]</p>
						</div>
						<div class="body-block">
							<h2>Email &amp; direct mail, connected</h2>
							<p class="placeholder-copy">[AUTO INSIGHTS EMAIL/MAIL COPY PENDING — managed in Storyblok]</p>
						</div>
					</>
				)
			}
		</div>
	</section>

	<section class="section cta">
		<div class="section-inner cta-inner reveal">
			<h2>See Auto Insights on your own data.</h2>
			<a class="btn btn-primary" href="/contact">Book a Demo</a>
		</div>
	</section>
</BaseLayout>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		background: var(--color-dark);
		color: var(--color-on-dark);
		text-align: center;
	}

	.hero-glow {
		position: absolute;
		inset: -20%;
		background: radial-gradient(
			40% 50% at 50% 40%,
			color-mix(in srgb, var(--color-accent) 45%, transparent),
			transparent
		);
		filter: blur(60px);
		animation: drift 18s ease-in-out infinite alternate;
	}

	@keyframes drift {
		0% {
			transform: translate(0, 0) scale(1);
		}
		100% {
			transform: translate(-3%, 4%) scale(1.08);
		}
	}

	.hero-inner {
		position: relative;
		z-index: 1;
		max-width: 680px;
		margin: 0 auto;
	}

	.hero h1 {
		font-size: clamp(2.25rem, 5vw, 3rem);
		color: var(--color-on-dark);
	}

	.hero-sub {
		font-size: 1.1rem;
		margin-bottom: 2rem;
		color: var(--color-on-dark-muted);
	}

	.body-block {
		margin-bottom: 2rem;
		padding: 1.75rem 2rem;
		border: 1px solid var(--color-border);
		border-left: 3px solid var(--color-accent);
		border-radius: 12px;
	}

	.body-block:last-child {
		margin-bottom: 0;
	}

	.body-block h2 {
		font-size: 1.3rem;
	}

	.cta-inner {
		text-align: center;
	}
</style>
