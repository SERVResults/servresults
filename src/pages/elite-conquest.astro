---
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getStory } from '../lib/storyblok';

const story = await getStory('elite-conquest');
const heroSubheading = story?.content?.hero_subheading;
const bodySections = story?.content?.body ?? [];
---

<BaseLayout title="Elite Conquest" description="Elite Conquest, from the team behind Auto Insights.">
	<section class="page-hero">
		<div class="wrap page-hero__inner">
			<p class="eyebrow eyebrow-muted">From the team behind Auto Insights</p>
			<h1>Elite Conquest</h1>
			{
				heroSubheading ? (
					<p class="hero-sub">{heroSubheading}</p>
				) : (
					<p class="hero-sub">Details on this offering are coming soon — get in touch and we'll walk you through it.</p>
				)
			}
			<div class="hero-actions">
				<a class="btn btn-outline-on-dark" href="/contact">Talk to Sales</a>
				<a class="text-link-on-dark" href="/auto-insights">See Auto Insights, our flagship platform &rarr;</a>
			</div>
		</div>
	</section>

	<section class="body-copy">
		<div class="wrap reveal">
			{
				bodySections.length > 0 ? (
					bodySections.map((blok) => <StoryblokComponent blok={blok} />)
				) : (
					<div class="body-block">
						<p>
							We're finalizing the write-up for Elite Conquest. In the meantime,{' '}
							<a href="/contact">contact us</a> and we'll walk you through what it offers.
						</p>
					</div>
				)
			}
		</div>
	</section>
</BaseLayout>

<style>
	.page-hero {
		background: var(--serv-ink);
		color: var(--serv-off);
		padding-block: clamp(3.5rem, 6vw, 5rem);
	}

	.page-hero__inner {
		max-width: 640px;
	}

	.page-hero h1 {
		color: var(--serv-off);
		font-size: clamp(2rem, 1.3rem + 2vw, 2.5rem);
	}

	.hero-sub {
		font-size: 1.05rem;
		color: var(--serv-text-muted-on-dark);
		margin-bottom: 1.5rem;
	}

	.hero-actions {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		flex-wrap: wrap;
	}

	.text-link-on-dark {
		font-weight: 600;
		color: var(--serv-off);
		text-decoration: none;
		font-size: 0.906rem;
	}

	.text-link-on-dark:hover {
		text-decoration: underline;
	}

	.body-copy {
		padding-block: clamp(3rem, 4vw, 4rem);
	}

	.body-block {
		padding: 1.75rem 2rem;
		border: 1px solid var(--serv-border-on-light);
		border-left: 3px solid var(--serv-primary);
	}

	.body-block a {
		color: var(--serv-primary-deep);
		font-weight: 600;
		text-decoration: underline;
	}
</style>
