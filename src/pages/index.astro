---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Home" description="SERV Results helps car dealerships find, convert, and retain more customers with data-driven marketing.">
	<section class="hero section">
		<div class="section-inner hero-inner">
			<p class="eyebrow">Auto Insights</p>
			<h1>Increase sales opportunities by 30% from existing dealer website traffic.</h1>
			<p class="hero-sub">Turn anonymous website visitors into high-closing leads.</p>
			<div class="hero-actions">
				<a class="btn btn-primary" href="/contact">Book a Demo</a>
				<a class="btn btn-secondary-on-dark" href="/auto-insights">Explore Auto Insights</a>
			</div>
		</div>
	</section>

	<section class="section proof">
		<div class="section-inner proof-inner">
			<p class="eyebrow">Guaranteed Results</p>
			<div class="stat-grid">
				<div class="stat">
					<p class="stat-number">30%+</p>
					<p class="stat-label">Minimum increase in 1st-party leads</p>
				</div>
				<div class="stat">
					<p class="stat-number">15.3%</p>
					<p class="stat-label">Average close rate</p>
				</div>
				<div class="stat">
					<p class="stat-number">~50%</p>
					<p class="stat-label">Engagement of daily website visitors</p>
				</div>
			</div>
		</div>
	</section>

	<section class="section value-props">
		<div class="section-inner">
			<h2>Turn anonymous traffic into closed deals</h2>
			<div class="value-grid">
				<div class="value-card">
					<h3>De-anonymize 50% of daily website traffic</h3>
				</div>
				<div class="value-card">
					<h3>Engage each visitor with 3+ emails</h3>
				</div>
				<div class="value-card">
					<h3>On-site offer engine to convert down-funnel shoppers</h3>
				</div>
				<div class="value-card">
					<h3>Maximize website conversion &mdash; 30% increase in dealership website leads</h3>
				</div>
			</div>
		</div>
	</section>

	<section class="section secondary-product">
		<div class="section-inner secondary-inner">
			<div class="secondary-text">
				<p class="eyebrow">Also from SERV Results</p>
				<h2>Elite Conquest</h2>
				<p class="placeholder-copy">[ELITE CONQUEST HOME BLURB COPY PENDING]</p>
				<a class="secondary-link" href="/elite-conquest">Learn about Elite Conquest &rarr;</a>
			</div>
		</div>
	</section>

	<section class="section cta">
		<div class="section-inner cta-inner">
			<h2>See Auto Insights on your own data.</h2>
			<p>Book a short demo and we'll walk through what it looks like for your dealership.</p>
			<a class="btn btn-primary" href="/contact">Book a Demo</a>
		</div>
	</section>
</BaseLayout>

<style>
	.hero {
		background: var(--color-dark);
		color: var(--color-on-dark);
	}

	.hero-inner {
		max-width: 760px;
		text-align: center;
		margin: 0 auto;
	}

	.hero h1 {
		font-size: clamp(2.25rem, 5vw, 3.5rem);
		color: var(--color-on-dark);
	}

	.hero-sub {
		font-size: 1.1rem;
		max-width: 56ch;
		margin: 0 auto 2rem;
		color: var(--color-on-dark-muted);
	}

	.hero-actions {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	.proof-inner {
		text-align: center;
	}

	.stat-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2rem;
	}

	.stat-number {
		font-family: var(--font-heading);
		font-size: 2.5rem;
		font-weight: 700;
		color: var(--color-accent);
		margin: 0;
	}

	.stat-label {
		margin: 0.25rem 0 0;
		font-size: 0.9rem;
	}

	@media (max-width: 700px) {
		.stat-grid {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}
	}

	.value-props h2 {
		text-align: center;
		max-width: 32ch;
		margin: 0 auto 3rem;
		font-size: 2rem;
	}

	.value-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.5rem;
	}

	.value-card {
		padding: 1.75rem;
		border: 1px solid var(--color-border);
		border-radius: 12px;
	}

	.value-card h3 {
		font-size: 1.15rem;
		margin: 0;
	}

	.secondary-product {
		background: var(--color-bg-alt);
	}

	.secondary-inner {
		max-width: 640px;
	}

	.secondary-link {
		display: inline-block;
		margin-top: 0.5rem;
		font-weight: 600;
		color: var(--color-accent);
		text-decoration: none;
	}

	.cta-inner {
		text-align: center;
		max-width: 560px;
	}

	.cta h2 {
		font-size: 2rem;
	}

	@media (max-width: 860px) {
		.value-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
