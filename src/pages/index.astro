---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroField from '../components/HeroField.astro';
import { getStory } from '../lib/storyblok';

const story = await getStory('home');
const content = story?.content ?? {};

const heroEyebrow = content.hero_eyebrow ?? 'Guaranteed Results';
const heroHeading =
	content.hero_heading ?? 'Increase sales opportunities by 30% from existing dealer website traffic';
const heroSub = content.hero_subheading ?? 'Turn anonymous website visitors into high-closing leads.';

const defaultStats = [
	{ number: '30%+', label: 'minimum increase in 1st party leads' },
	{ number: '15.3%', label: 'close rate average' },
	{ number: '~50%', label: 'of daily website visitors engaged' },
];
const stats = content.stats?.length ? content.stats : defaultStats;

const sectionEyebrow = content.section_eyebrow ?? 'Core Product';
const sectionHeading = content.section_heading ?? 'Auto Insights';
const sectionTag = content.section_tag ?? 'Four steps, one tag on your site';
const sectionIntro =
	content.section_intro ??
	"Your website already has the audience. Auto Insights identifies it, engages it, and converts it - without adding third-party lead spend.";

const defaultStepHeadings = [
	'De-anonymize 50% of daily website traffic',
	'Engage each visitor with 3+ emails',
	'On-site offer engine converts down-funnel shoppers',
	'Maximize website conversion - 30% more leads',
];
const stepHeadings = content.features?.length
	? defaultStepHeadings.map((fallback, i) => content.features[i]?.heading || fallback)
	: defaultStepHeadings;

const teaserEyebrow = content.teaser_eyebrow ?? 'Also Available';
const teaserHeading = content.teaser_heading ?? 'Elite Conquest';
const teaserBody =
	content.teaser_body ??
	'Identifies in-market shoppers who visit your website and leave without converting, then re-engages them with branded email while the buying signal is still fresh.';

const closingHeading =
	content.closing_heading ?? 'Leadership team with 100+ years of combined automotive experience';
const closingBody =
	content.closing_body ??
	"With a leadership and product team owning OEM, retail, and vendor experience, SERV Results is attacking an issue that often gets overlooked in automotive digital marketing: creating real results and conversion from the dealership's existing website traffic.";
---

<BaseLayout
	title="SERV Results | Data-Driven Marketing for Car Dealerships"
	description="SERV Results helps car dealerships find, convert, and retain more customers with data-driven marketing."
>
	<section class="hero">
		<HeroField variant="home" withCar />
		<div class="wrap hero__grid">
			<div class="hero__copy">
				<p class="eyebrow">{heroEyebrow}</p>
				<h1>{heroHeading}</h1>
				<p class="hero__sub">{heroSub}</p>
				<div class="hero__actions">
					<a class="btn btn-primary" href="/contact">Schedule a 20-minute demo</a>
					<a class="btn btn-outline-on-dark" href="/auto-insights">See Auto Insights</a>
				</div>
			</div>
			<div class="hero__stats">
				{
					stats.map((stat) => (
						<div class="hero__stat">
							<p class="hero__stat-number">{stat.number}</p>
							<p class="hero__stat-label">{stat.label}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="band band-core">
		<div class="wrap">
			<div class="band-core__head">
				<div>
					<p class="eyebrow eyebrow-deep">{sectionEyebrow}</p>
					<h2>{sectionHeading}</h2>
				</div>
				<p class="band-core__tag">{sectionTag}</p>
			</div>
			<p class="band-core__intro">{sectionIntro}</p>

			<div class="step-grid">
				<div class="step-card">
					<div class="step-card__diagram" aria-hidden="true">
						<div class="ping-grid">
							<i></i><i class="is-active" style="animation-delay:0s"></i><i></i>
							<i class="is-active" style="animation-delay:.3s"></i><i class="is-active" style="animation-delay:.6s"></i><i></i>
							<i class="is-active" style="animation-delay:.9s"></i><i></i><i class="is-active" style="animation-delay:1.2s"></i>
							<i></i><i class="is-active" style="animation-delay:1.5s"></i><i></i>
						</div>
						<p class="step-card__caption">50 of 100 sessions matched</p>
					</div>
					<h3>{stepHeadings[0]}</h3>
				</div>

				<div class="step-card">
					<div class="step-card__diagram" aria-hidden="true">
						<div class="growth-bars">
							<span style="animation-delay:0s"></span>
							<span style="animation-delay:.35s"></span>
							<span style="animation-delay:.7s"></span>
						</div>
						<p class="step-card__caption">3+ emails per visitor</p>
					</div>
					<h3>{stepHeadings[1]}</h3>
				</div>

				<div class="step-card">
					<div class="step-card__diagram" aria-hidden="true">
						<div class="exit-bars">
							<i style="height:26%"></i><i style="height:48%"></i><i style="height:70%"></i>
							<i class="is-active" style="height:100%"></i>
						</div>
						<p class="step-card__caption">offer served at exit intent</p>
					</div>
					<h3>{stepHeadings[2]}</h3>
				</div>

				<div class="step-card">
					<div class="step-card__diagram step-card__diagram--tinted" aria-hidden="true">
						<div class="before-after">
							<div class="before-after__col">
								<div class="before-after__bar before-after__bar--before"></div>
								<span class="before-after__label">BEFORE</span>
							</div>
							<div class="before-after__col">
								<div class="before-after__bar before-after__bar--after"></div>
								<span class="before-after__label before-after__label--after">AFTER</span>
							</div>
						</div>
						<p class="step-card__caption">+30% 1st party leads</p>
					</div>
					<h3>{stepHeadings[3]}</h3>
				</div>
			</div>

			<a class="text-link" href="/auto-insights">Explore Auto Insights &rarr;</a>
		</div>
	</section>

	<section class="band band-elite">
		<div class="wrap band-elite__inner">
			<div>
				<p class="eyebrow eyebrow-muted">{teaserEyebrow}</p>
				<h3>{teaserHeading}</h3>
				<p>{teaserBody}</p>
			</div>
			<a class="text-link" href="/elite-conquest">Learn more &rarr;</a>
		</div>
	</section>

	<section class="band band-leadership">
		<div class="wrap band-leadership__inner">
			<h3>{closingHeading}</h3>
			<p>{closingBody}</p>
		</div>
	</section>
</BaseLayout>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		background: var(--serv-ink);
		color: var(--serv-off);
		min-height: calc(100vh - var(--nav-height));
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding-block: clamp(5.5rem, 9vw, 7rem) clamp(7rem, 12vw, 10rem);
	}

	.hero__grid {
		position: relative;
		z-index: 2;
		width: 100%;
		display: grid;
		grid-template-columns: 1.15fr 0.85fr;
		gap: 4rem;
		align-items: end;
	}

	.hero h1 {
		font-size: clamp(2.125rem, 1.05rem + 4.6vw, 3.875rem);
		letter-spacing: -0.025em;
		text-wrap: balance;
		color: var(--serv-off);
		margin: 0;
	}

	.hero__sub {
		font-size: clamp(1rem, 0.85rem + 0.5vw, 1.125rem);
		max-width: 44ch;
		color: var(--serv-text-muted-on-dark);
		margin: 1.75rem 0 0;
	}

	.hero__actions {
		display: flex;
		gap: 0.875rem;
		margin-top: 2.375rem;
		flex-wrap: wrap;
	}

	.hero__stats {
		display: flex;
		flex-direction: column;
		gap: 1px;
		background: rgb(255 255 255 / 12%);
	}

	.hero__stat {
		background: var(--serv-ink);
		padding: 1.625rem 1.75rem;
	}

	.hero__stat-number {
		font-size: 2.875rem;
		line-height: 1;
		font-weight: 600;
		letter-spacing: -0.03em;
		color: var(--serv-primary);
		margin: 0;
	}

	.hero__stat-label {
		margin: 0.5625rem 0 0;
		font-size: 0.844rem;
		color: var(--serv-text-muted-on-dark);
	}

	@media (max-width: 860px) {
		.hero__grid {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}
	}

	@media (max-width: 640px) {
		.hero {
			padding-block: 1.75rem 3.5rem;
		}

		.hero .eyebrow {
			margin-bottom: 0.625rem;
		}

		.hero__grid {
			gap: 1rem;
		}

		.hero h1 {
			font-size: clamp(1.5rem, 1.05rem + 4vw, 1.75rem);
		}

		.hero__sub {
			margin-top: 0.625rem;
			font-size: 0.88rem;
		}

		.hero__actions {
			flex-direction: column;
			align-items: stretch;
			margin-top: 1rem;
			gap: 0.5rem;
		}

		.hero__actions .btn {
			padding: 0.625rem 1.25rem;
		}

		.hero__stat {
			padding: 0.5rem 1rem;
		}

		.hero__stat-number {
			font-size: 1.375rem;
		}

		.hero__stat-label {
			margin-top: 0.2rem;
			font-size: 0.68rem;
		}
	}

	.band-core {
		background: var(--serv-off);
		padding-block: clamp(3rem, 5vw, 4.75rem);
	}

	.band-core__head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		flex-wrap: wrap;
		margin-bottom: 0.875rem;
	}

	.band-core__head h2 {
		font-size: clamp(1.75rem, 1.2rem + 2.4vw, 2.5rem);
		letter-spacing: -0.02em;
		color: var(--serv-ink);
		margin: 0;
	}

	.band-core__tag {
		font-family: var(--font-mono);
		font-size: 0.719rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--serv-text-faint-on-light);
		margin: 0;
		white-space: nowrap;
	}

	.band-core__intro {
		max-width: 60ch;
		font-size: 1.03rem;
		line-height: 1.6;
		color: var(--serv-text-muted-on-light);
		margin: 0 0 2.75rem;
	}

	.step-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1.5rem;
		margin-bottom: 1.875rem;
	}

	.step-card__diagram {
		height: 132px;
		background: #fff;
		border: 1px solid var(--serv-border-on-light);
		padding: 1.125rem;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		overflow: hidden;
	}

	.step-card__diagram--tinted {
		background: #eef2fc;
		border-color: rgb(58 95 192 / 28%);
	}

	.step-card__caption {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.656rem;
		color: var(--serv-text-faint-on-light);
	}

	.step-card__diagram--tinted .step-card__caption {
		color: var(--serv-primary-deep);
	}

	.step-card h3 {
		margin: 1rem 0 0;
		font-size: 1.03rem;
		line-height: 1.35;
		color: var(--serv-ink);
	}

	.ping-grid {
		display: grid;
		grid-template-columns: repeat(6, 1fr);
		gap: 6px;
	}

	.ping-grid i {
		height: 9px;
		display: block;
		background: var(--serv-border-on-light-strong);
	}

	.ping-grid i.is-active {
		background: var(--serv-primary);
		animation: servPing 2.4s ease-in-out infinite;
		animation-play-state: var(--serv-play, running);
	}

	.growth-bars {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.growth-bars span {
		display: block;
		height: 14px;
		background: #e2e8f8;
		border-left: 3px solid var(--serv-primary);
		transform-origin: left;
		animation: servGrow 3s ease-out infinite;
		animation-play-state: var(--serv-play, running);
	}

	.exit-bars {
		display: flex;
		gap: 6px;
		align-items: flex-end;
		height: 56px;
	}

	.exit-bars i {
		width: 22%;
		display: block;
		background: var(--serv-border-on-light-strong);
	}

	.exit-bars i.is-active {
		background: var(--serv-primary);
		animation: servPing 2.4s ease-in-out infinite;
		animation-play-state: var(--serv-play, running);
	}

	.before-after {
		display: flex;
		align-items: flex-end;
		gap: 14px;
		height: 56px;
	}

	.before-after__col {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 6px;
		align-items: center;
	}

	.before-after__bar {
		width: 100%;
	}

	.before-after__bar--before {
		height: 34px;
		background: var(--serv-border-on-light-strong);
	}

	.before-after__bar--after {
		height: 46px;
		background: var(--serv-primary);
		transform-origin: bottom;
		animation: servPing 2.8s ease-in-out infinite;
		animation-play-state: var(--serv-play, running);
	}

	.before-after__label {
		font-family: var(--font-mono);
		font-size: 0.594rem;
		color: var(--serv-text-faint-on-light);
	}

	.before-after__label--after {
		color: var(--serv-primary-deep);
	}

	@media (max-width: 900px) {
		.step-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 560px) {
		.step-grid {
			grid-template-columns: 1fr;
		}
	}

	.band-elite {
		background: #fff;
		border-top: 1px solid var(--serv-border-on-light);
		padding-block: clamp(2.75rem, 4vw, 3.5rem);
	}

	.band-elite__inner {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 2.5rem;
		align-items: center;
	}

	.band-elite__inner h3 {
		font-size: 1.5rem;
		color: var(--serv-ink);
		margin: 0 0 0.625rem;
	}

	.band-elite__inner p {
		margin: 0;
		max-width: 60ch;
	}

	@media (max-width: 700px) {
		.band-elite__inner {
			grid-template-columns: 1fr;
		}
	}

	.band-leadership {
		background: var(--serv-ink);
		color: var(--serv-off);
		padding-block: clamp(3rem, 5vw, 4rem);
	}

	.band-leadership__inner {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3.5rem;
		align-items: center;
	}

	.band-leadership__inner h3 {
		color: var(--serv-off);
		font-size: clamp(1.5rem, 1.1rem + 1.6vw, 1.875rem);
		letter-spacing: -0.02em;
		margin: 0;
	}

	.band-leadership__inner p {
		color: var(--serv-text-muted-on-dark);
		font-size: 0.97rem;
		line-height: 1.65;
		margin: 0;
	}

	@media (max-width: 780px) {
		.band-leadership__inner {
			grid-template-columns: 1fr;
		}
	}
</style>
