---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroField from '../components/HeroField.astro';

const quickLinks = [
	{ href: '/auto-insights', label: 'Auto Insights' },
	{ href: '/elite-conquest', label: 'Elite Conquest' },
	{ href: '/about', label: 'About' },
	{ href: '/contact', label: 'Contact' },
];
---

<BaseLayout
	title="Page Not Found"
	description="The page you're looking for doesn't exist or may have moved."
	noindex
>
	<section class="not-found">
		<HeroField variant="product" withCar />
		<div class="wrap not-found__inner">
			<p class="eyebrow">404</p>
			<h1>Wrong turn.</h1>
			<p class="not-found__sub">
				The page you're looking for doesn't exist or may have moved. Let's get you back on route.
			</p>
			<div class="not-found__actions">
				<a class="btn btn-primary" href="/">Back to home</a>
				<a class="btn btn-outline-on-dark" href="/contact">Contact us</a>
			</div>
			<ul class="not-found__links">
				{
					quickLinks.map((link) => (
						<li>
							<a href={link.href}>{link.label}</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>
</BaseLayout>

<style>
	.not-found {
		position: relative;
		overflow: hidden;
		background: var(--serv-ink);
		color: var(--serv-off);
		min-height: calc(100vh - var(--nav-height) - var(--footer-height));
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		padding-block: clamp(2.5rem, 6vw, 4rem);
	}

	.not-found__inner {
		position: relative;
		z-index: 2;
		max-width: 560px;
	}

	.not-found .eyebrow {
		font-size: 0.8rem;
	}

	.not-found h1 {
		color: var(--serv-off);
		font-size: clamp(2.25rem, 1.5rem + 3vw, 3.25rem);
		letter-spacing: -0.02em;
	}

	.not-found__sub {
		font-size: 1.05rem;
		color: var(--serv-text-muted-on-dark);
		margin: 0 auto 2rem;
		max-width: 46ch;
	}

	.not-found__actions {
		display: flex;
		justify-content: center;
		gap: 0.875rem;
		flex-wrap: wrap;
	}

	.not-found__links {
		list-style: none;
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 1.5rem;
		margin: 2.75rem 0 0;
		padding-top: 1.75rem;
		border-top: 1px solid var(--serv-border-on-dark);
	}

	.not-found__links a {
		font-size: 0.85rem;
		font-weight: 500;
		color: var(--serv-text-muted-on-dark);
		text-decoration: none;
		transition: color 0.15s ease;
	}

	.not-found__links a:hover {
		color: var(--serv-off);
	}

	@media (max-width: 480px) {
		.not-found__actions {
			flex-direction: column;
		}
	}
</style>
