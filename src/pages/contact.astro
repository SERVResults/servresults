---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroField from '../components/HeroField.astro';
import ContactForm from '../components/ContactForm.astro';
---

<BaseLayout title="Contact" description="Book a demo or get in touch with SERV Results.">
	<section class="contact-hero">
		<HeroField variant="product" />
		<div class="wrap contact-hero__grid">
			<div class="contact-copy">
				<p class="eyebrow">Contact</p>
				<h1>Schedule a demo</h1>
				<p class="contact-copy__sub">
					Tell us a bit about your dealership and we'll show you what Auto Insights looks like on your own
					website traffic — no canned demo, just your data.
				</p>
				<ul class="contact-points">
					<li>No canned demo — we use your own site traffic</li>
					<li>20 minutes, start to finish</li>
					<li>Walk away with real numbers for your dealership</li>
				</ul>
			</div>

			<div class="contact-form-card">
				<ContactForm />
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.contact-hero {
		position: relative;
		overflow: hidden;
		background: var(--serv-ink);
		color: var(--serv-off);
		min-height: calc(100vh - var(--nav-height) - var(--footer-height));
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding-block: clamp(1.75rem, 3vw, 2.75rem);
	}

	.contact-hero__grid {
		position: relative;
		z-index: 2;
		width: 100%;
		display: grid;
		grid-template-columns: 1fr 1.05fr;
		gap: 4rem;
		align-items: start;
	}

	.contact-copy h1 {
		color: var(--serv-off);
		font-size: clamp(2rem, 1.3rem + 2vw, 2.5rem);
	}

	.contact-copy__sub {
		font-size: 1.02rem;
		color: var(--serv-text-muted-on-dark);
		margin: 0;
	}

	.contact-points {
		list-style: none;
		margin: 1.25rem 0 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.625rem;
	}

	.contact-points li {
		display: flex;
		gap: 0.75rem;
		align-items: baseline;
		font-size: 0.94rem;
		color: var(--serv-text-muted-on-dark);
	}

	.contact-points li::before {
		content: '';
		flex: none;
		width: 16px;
		height: 2px;
		margin-top: 0.5em;
		background: var(--serv-primary);
	}

	.contact-form-card {
		position: relative;
		background: #fff;
		color: var(--serv-text-on-light);
		padding: 1.5rem;
		border: 1px solid var(--serv-border-on-dark-strong);
	}

	@media (max-width: 860px) {
		.contact-hero {
			min-height: auto;
		}

		.contact-hero__grid {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}
	}

	@media (max-height: 760px) {
		.contact-hero {
			padding-block: 1rem;
		}

		.contact-points {
			margin-top: 1rem;
			gap: 0.5rem;
		}

		.contact-form-card {
			padding: 1.125rem;
		}
	}
</style>
