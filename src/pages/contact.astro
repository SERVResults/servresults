---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
---

<BaseLayout title="Contact" description="Book a demo or get in touch with SERV Results.">
	<section class="page-hero">
		<div class="wrap page-hero__inner">
			<p class="eyebrow">Contact</p>
			<h1>Schedule a demo</h1>
			<p>
				Tell us a bit about your dealership and we'll show you what Auto Insights looks like on your own
				website traffic — no canned demo, just your data.
			</p>
		</div>
	</section>

	<section class="contact-section">
		<div class="wrap">
			<ContactForm />
		</div>
	</section>
</BaseLayout>

<style>
	.page-hero {
		background: var(--serv-ink);
		color: var(--serv-off);
		padding-block: clamp(3.5rem, 6vw, 5rem);
	}

	.page-hero__inner {
		max-width: 640px;
	}

	.page-hero h1 {
		color: var(--serv-off);
		font-size: clamp(2rem, 1.3rem + 2vw, 2.5rem);
	}

	.page-hero p {
		color: var(--serv-text-muted-on-dark);
		margin-bottom: 0;
	}

	.contact-section {
		padding-block: clamp(3rem, 4vw, 4rem);
	}
</style>
