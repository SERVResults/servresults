---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroField from '../components/HeroField.astro';
import ContactForm from '../components/ContactForm.astro';
import { getStory } from '../lib/storyblok';

const story = await getStory('contact');
const content = story?.content ?? {};

const heroEyebrow = content.hero_eyebrow ?? 'Contact';
const heroHeading = content.hero_heading ?? 'Schedule a demo';
const heroSubheading =
	content.hero_subheading ??
	"Tell us a bit about your dealership and we'll show you what Auto Insights looks like on your own website traffic - no canned demo, just your data.";

const defaultPoints = [
	{ text: 'No canned demo - we use your own site traffic' },
	{ text: '20 minutes, start to finish' },
	{ text: 'Walk away with real numbers for your dealership' },
];
const points = content.hero_points?.length ? content.hero_points : defaultPoints;

const bookingUrl =
	'https://outlook.office.com/book/G7d9e5f8fa59d4be89515e4b04456db0a@NETORG20650421.onmicrosoft.com/';
---

<BaseLayout
	title="Contact"
	description="Schedule a 20-minute demo to see Auto Insights on your own dealership's website traffic, or send SERV Results a message."
>
	<section class="contact-hero">
		<HeroField variant="product" />
		<div class="wrap contact-hero__grid">
			<div class="contact-copy">
				<p class="eyebrow">{heroEyebrow}</p>
				<h1>{heroHeading}</h1>
				<p class="contact-copy__sub">{heroSubheading}</p>
				<ul class="contact-points">
					{points.map((point) => <li>{point.text}</li>)}
				</ul>
			</div>

			<div class="contact-form-card">
				<div class="option-tabs" role="tablist">
					<button type="button" class="option-tab is-active" data-tab="message" role="tab" aria-selected="true">
						Send a message
					</button>
					<button type="button" class="option-tab" data-tab="book" role="tab" aria-selected="false">
						Schedule a demo
					</button>
				</div>

				<div class="option-panel" data-panel="message">
					<ContactForm />
				</div>

				<div class="option-panel" data-panel="book" hidden>
					<iframe
						class="booking-frame"
						src={bookingUrl}
						title="Schedule a demo with SERV Results"
						loading="lazy"
					/>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

<script>
	const tabs = document.querySelectorAll<HTMLButtonElement>('.option-tab');
	const panels = document.querySelectorAll<HTMLElement>('.option-panel');

	tabs.forEach((tab) => {
		tab.addEventListener('click', () => {
			tabs.forEach((t) => {
				t.classList.toggle('is-active', t === tab);
				t.setAttribute('aria-selected', String(t === tab));
			});
			panels.forEach((panel) => {
				panel.hidden = panel.dataset.panel !== tab.dataset.tab;
			});
		});
	});
</script>

<style>
	.contact-hero {
		position: relative;
		overflow: hidden;
		background: var(--serv-ink);
		color: var(--serv-off);
		min-height: calc(100vh - var(--nav-height) - var(--footer-height));
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding-block: clamp(1.75rem, 3vw, 2.75rem);
	}

	.contact-hero__grid {
		position: relative;
		z-index: 2;
		width: 100%;
		display: grid;
		grid-template-columns: 1fr 1.05fr;
		gap: 4rem;
		align-items: start;
	}

	.contact-copy h1 {
		color: var(--serv-off);
		font-size: clamp(2rem, 1.3rem + 2vw, 2.5rem);
	}

	.contact-copy__sub {
		font-size: 1.02rem;
		color: var(--serv-text-muted-on-dark);
		margin: 0;
	}

	.contact-points {
		list-style: none;
		margin: 1.25rem 0 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.625rem;
	}

	.contact-points li {
		display: flex;
		gap: 0.75rem;
		align-items: baseline;
		font-size: 0.94rem;
		color: var(--serv-text-muted-on-dark);
	}

	.contact-points li::before {
		content: '';
		flex: none;
		width: 16px;
		height: 2px;
		margin-top: 0.5em;
		background: var(--serv-primary);
	}

	.contact-form-card {
		position: relative;
		background: #fff;
		color: var(--serv-text-on-light);
		padding: 1.5rem;
		border: 1px solid var(--serv-border-on-dark-strong);
	}

	.option-tabs {
		display: flex;
		gap: 1px;
		background: var(--serv-border-on-light-strong);
		border: 1px solid var(--serv-border-on-light-strong);
		margin-bottom: 1rem;
	}

	.option-tab {
		flex: 1;
		padding: 0.75rem 1rem;
		background: var(--serv-off);
		color: var(--serv-text-muted-on-light);
		border: none;
		font: inherit;
		font-weight: 600;
		font-size: 0.875rem;
		cursor: pointer;
		transition: background-color 0.15s ease, color 0.15s ease;
	}

	.option-tab.is-active {
		background: var(--serv-primary);
		color: #fff;
	}

	.option-panel {
		height: 470px;
	}

	.option-panel[data-panel='message'] {
		overflow-y: auto;
	}

	.option-panel[hidden] {
		display: none;
	}

	.booking-frame {
		width: 100%;
		height: 100%;
		border: 0;
		display: block;
	}

	@media (max-width: 860px) {
		.contact-hero {
			min-height: auto;
		}

		.contact-hero__grid {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}
	}

	@media (max-height: 760px) {
		.contact-hero {
			padding-block: 1rem;
		}

		.contact-points {
			margin-top: 1rem;
			gap: 0.5rem;
		}

		.contact-form-card {
			padding: 1.125rem;
		}

		.option-panel {
			height: 320px;
		}
	}
</style>
