---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getStories, getStory } from '../lib/storyblok';

const jobStories = await getStories('jobs/');
const story = await getStory('about');
const content = story?.content ?? {};

const heroEyebrow = content.hero_eyebrow ?? 'About SERV Results';
const heroHeading =
	content.hero_heading ?? 'Automotive Experts. OEM Partners. Data Strategists. Dealer-Process Experts.';
const heroSubheading =
	content.hero_subheading ??
	'Our leadership team brings firsthand perspective from OEMs, retail groups, and the vendor organizations that serve dealerships. That experience shapes a program designed for corporate confidence and dealer-level adoption.';

const defaultExperience = { number: '100+', label: 'years combined automotive experience' };
const experience = content.stats?.[0] ?? defaultExperience;

const defaultPillars = [
	{ heading: 'OEM & Retail Perspective', body: 'Experience across manufacturer, dealer, and partner environments.' },
	{
		heading: 'Tier 1–3 Expertise',
		body: 'Strategic view from national, regional, and dealership execution levels.',
	},
	{
		heading: 'Data-Led Innovation',
		body: 'Focused on identifying hidden demand already visiting dealer websites.',
	},
	{
		heading: 'Email Marketing Execution',
		body: 'Dealer-branded campaigns that re-engage shoppers and create return visits.',
	},
];
const pillars = content.features?.length ? content.features : defaultPillars;

const team = [
	{ name: 'Sean Vega', title: 'CEO / Managing Partner', photo: '/team/sean-vega.jpg' },
	{ name: 'Scottie Eisenfelder', title: 'CPO / Operating Partner', photo: '/team/scottie-eisenfelder.png' },
	{ name: 'Jay Erkman', title: 'Vice President, Sales / Partner', photo: '/team/jay-erkman.jpg' },
	{ name: 'Marvin Grimm', title: 'Executive Vice President', photo: '/team/marvin-grimm.png' },
	{ name: 'Derek Rousso', title: 'Director of Operations', photo: '/team/derek-rousso.jpg' },
	{ name: 'Michael Cappelli', title: 'Director of Support', photo: '/team/michael-cappelli.png' },
	{ name: 'Karen Wallace', title: 'Accounting & Office Director', photo: '/team/karen-wallace.png' },
	{ name: 'Jennifer Volatile', title: 'HR Director', photo: '/team/jennifer-volatile.png' },
	{ name: 'Joe Finger', title: 'SERV Results', photo: '/team/joe-finger.png' },
	{ name: 'Scot Eisenfelder', title: 'Founder/Managing Partner - SERV Holdings', photo: '/team/scot-eisenfelder.png' },
	{ name: 'Rob Volatile', title: 'Founder/Managing Partner - SERV Holdings', photo: '/team/rob-volatile.jpg' },
];
---

<BaseLayout title="About" description="SERV Results builds data-driven marketing software for car dealerships.">
	<section class="page-hero">
		<div class="wrap page-hero__inner">
			<p class="eyebrow">{heroEyebrow}</p>
			<h1>{heroHeading}</h1>
			<p>{heroSubheading}</p>
		</div>
	</section>

	<section class="who-we-are">
		<div class="wrap who-we-are__inner reveal">
			<div class="experience-card">
				<p class="experience-number">{experience.number}</p>
				<p class="experience-label">{experience.label}</p>
			</div>
			<div class="pillar-grid">
				{
					pillars.map((pillar) => (
						<div class="pillar">
							<h3>{pillar.heading}</h3>
							<p>{pillar.body}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="team">
		<div class="wrap reveal">
			<p class="eyebrow eyebrow-deep">Meet Our Team</p>
			<div class="team-grid">
				{
					team.map((member) => (
						<div class="team-member">
							<img class="team-photo" src={member.photo} alt={member.name} width="76" height="76" loading="lazy" />
							<p class="team-name">{member.name}</p>
							{member.title && <p class="team-title">{member.title}</p>}
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="brands">
		<div class="wrap reveal">
			<p class="eyebrow eyebrow-muted">Who We Work With</p>
			<!-- Neutral wordmark chips, not licensed OEM logo marks — swap in licensed SVG/PNG logo assets from the client once cleared for use. -->
			<ul class="brand-list">
				{
					[
						'Subaru', 'Mazda', 'Chevrolet', 'GM', 'Lincoln', 'Mitsubishi', 'Buick', 'Kia', 'Honda', 'Hyundai',
						'Ford', 'GMC', 'Nissan', 'Stellantis', 'Dodge', 'Acura', 'Porsche', 'Audi', 'Mercedes-Benz',
						'Jaguar', 'Land Rover', 'Bentley', 'Ferrari',
					].map((brand) => (
						<li class="brand-chip">
							<span>{brand}</span>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	{
		jobStories.length > 0 && (
			<section class="hiring">
				<div class="wrap reveal">
					<h2>We're hiring</h2>
					<div class="job-list">
						{jobStories.map((job) => (
							<article class="job-summary">
								<h3>{job.content.title ?? job.name}</h3>
								{job.content.location && <p class="job-meta">{job.content.location}</p>}
							</article>
						))}
					</div>
					<a class="btn btn-outline-on-light" href="/contact">
						Get in touch about openings
					</a>
				</div>
			</section>
		)
	}
</BaseLayout>

<style>
	.page-hero {
		background: var(--serv-ink);
		color: var(--serv-off);
		padding-block: clamp(3.5rem, 6vw, 5rem);
	}

	.page-hero__inner {
		max-width: 680px;
	}

	.page-hero h1 {
		color: var(--serv-off);
		font-size: clamp(2rem, 1.3rem + 2.4vw, 2.75rem);
		letter-spacing: -0.02em;
	}

	.page-hero p {
		font-size: 1.05rem;
		max-width: 60ch;
		color: var(--serv-text-muted-on-dark);
		margin-bottom: 0;
	}

	.who-we-are {
		padding-block: clamp(3rem, 5vw, 4.75rem);
	}

	.who-we-are__inner {
		display: grid;
		grid-template-columns: minmax(220px, 320px) 1fr;
		gap: 2.5rem;
		align-items: start;
	}

	.experience-card {
		padding: 2rem;
		background: var(--serv-off);
		border-left: 3px solid var(--serv-primary);
	}

	.experience-number {
		font-size: 2.75rem;
		font-weight: 600;
		letter-spacing: -0.03em;
		color: var(--serv-primary);
		margin: 0;
	}

	.experience-label {
		margin: 0.25rem 0 0;
		font-weight: 600;
		color: var(--serv-ink);
	}

	.pillar-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1px;
		background: var(--serv-border-on-light-strong);
		border: 1px solid var(--serv-border-on-light-strong);
	}

	.pillar {
		background: #fff;
		padding: 1.5rem;
	}

	.pillar h3 {
		font-size: 1.05rem;
		color: var(--serv-ink);
		margin-bottom: 0.5rem;
	}

	.pillar p {
		margin: 0;
		font-size: 0.92rem;
	}

	@media (max-width: 780px) {
		.who-we-are__inner {
			grid-template-columns: 1fr;
		}
	}

	.team {
		border-top: 1px solid var(--serv-border-on-light);
		padding-block: clamp(3rem, 4vw, 4rem);
	}

	.team-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
		gap: 2.25rem 1.5rem;
		margin-top: 1.75rem;
	}

	.team-member {
		text-align: center;
	}

	.team-photo {
		width: 76px;
		height: 76px;
		border-radius: 50%;
		object-fit: cover;
		filter: grayscale(1);
		margin: 0 auto 0.9375rem;
	}

	.team-name {
		margin: 0;
		font-size: 0.94rem;
		font-weight: 600;
		color: var(--serv-ink);
	}

	.team-title {
		margin: 0.25rem 0 0;
		font-size: 0.78rem;
		line-height: 1.4;
		color: var(--serv-text-muted-on-light);
	}

	.brands {
		background: var(--serv-off);
		border-top: 1px solid var(--serv-border-on-light);
		border-bottom: 1px solid var(--serv-border-on-light);
		padding-block: clamp(2.75rem, 4vw, 3.5rem);
	}

	.brand-list {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 1px;
		background: var(--serv-border-on-light-strong);
		border: 1px solid var(--serv-border-on-light-strong);
		margin: 1.5rem 0 0;
		padding: 0;
	}

	.brand-chip {
		background: #fff;
		padding: 0.875rem 1.25rem;
		display: flex;
		align-items: center;
		flex: 1 1 auto;
	}

	.brand-chip span {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 500;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--serv-text-muted-on-light);
		white-space: nowrap;
	}

	.hiring {
		padding-block: clamp(3rem, 4vw, 4rem);
	}

	.hiring h2 {
		color: var(--serv-ink);
	}

	.job-list {
		display: grid;
		gap: 1px;
		background: var(--serv-border-on-light-strong);
		border: 1px solid var(--serv-border-on-light-strong);
		margin: 1.5rem 0 2rem;
	}

	.job-summary {
		background: #fff;
		padding: 1rem 1.5rem;
	}

	.job-summary h3 {
		margin: 0;
		font-size: 1rem;
		color: var(--serv-ink);
	}

	.job-meta {
		margin: 0.25rem 0 0;
		font-size: 0.85rem;
	}
</style>
