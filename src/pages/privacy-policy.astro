---
import BaseLayout from '../layouts/BaseLayout.astro';

const lastUpdated = 'August 2026';
---

<BaseLayout title="Privacy Policy" description="How SERV Results collects, uses, and protects your information.">
	<section class="section">
		<div class="section-inner content">
			<p class="eyebrow">Privacy Policy</p>
			<h1>Privacy Policy</h1>
			<p class="placeholder-copy">
				[DRAFT — this page is scaffolding, not legal advice. Have counsel review before launch.]
			</p>
			<p class="updated">Last updated: {lastUpdated}</p>

			<h2>Information we collect</h2>
			<p>
				When you submit our contact or demo request form, we collect the information you provide: your name,
				email address, dealership name, and message. We do not currently use cookies or analytics tracking on
				this site.
			</p>

			<h2>How we use your information</h2>
			<p>
				We use the information you submit solely to respond to your inquiry and follow up about SERV Results
				products and services. We do not sell your information to third parties.
			</p>

			<h2>How we store your information</h2>
			<p>
				Form submissions are sent to our internal team for follow-up. We retain this information only as long
				as needed to respond to your inquiry and maintain our business records.
			</p>

			<h2>Your choices</h2>
			<p>
				To request that we delete information you've submitted, or if you have questions about this policy,
				contact us at <a href="mailto:privacy@servresults.com">privacy@servresults.com</a>.
			</p>

			<h2>Changes to this policy</h2>
			<p>We may update this policy from time to time. Changes will be posted on this page with an updated date.</p>
		</div>
	</section>
</BaseLayout>

<style>
	.content {
		max-width: 720px;
	}

	.updated {
		font-size: 0.85rem;
		margin-bottom: 2.5rem;
	}

	h2 {
		font-size: 1.25rem;
		margin-top: 2.5rem;
	}
</style>
