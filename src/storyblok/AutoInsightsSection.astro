---
import { storyblokEditable, renderRichText } from '@storyblok/astro';

interface Props {
	blok: {
		_uid: string;
		component: string;
		heading?: string;
		body?: Record<string, unknown>;
		[key: string]: unknown;
	};
}

const { blok } = Astro.props;
const html = blok.body ? renderRichText(blok.body) : '';
---

<div class="step-row" {...storyblokEditable(blok)}>
	<span class="step-row__marker" aria-hidden="true"></span>
	{blok.heading && <h3>{blok.heading}</h3>}
	<div class="step-row__body">
		{html ? <Fragment set:html={html} /> : <p class="placeholder-copy">[AUTO INSIGHTS SECTION COPY PENDING]</p>}
	</div>
</div>
