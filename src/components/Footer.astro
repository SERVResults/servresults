---
import { getStory } from '../lib/storyblok';

const settingsStory = await getStory('settings');
const settings = settingsStory?.content ?? {};

const address = settings.footer_address ?? '1000 NW 65th St #305, Fort Lauderdale, FL 33309';
const phone = settings.footer_phone ?? '954-420-6040';
const email = settings.footer_email ?? 'info@servresults.com';
---

<footer class="site-footer">
	<div class="wrap">
		<span class="footer-brand">
			<img class="footer-mark" src="/brand/logo-mark-color.png" alt="" width="22" height="22" />
			{address} &middot; {phone} &middot; {email}
		</span>
		<span class="footer-links">
			<a href="/privacy-policy">Privacy Policy</a>
		</span>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--serv-off);
	}

	.wrap {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 1rem;
		min-height: var(--footer-height);
		box-sizing: border-box;
		padding-block: 1.375rem;
		font-size: 0.78rem;
		color: var(--serv-text-muted-on-light);
	}

	.footer-brand {
		display: flex;
		align-items: center;
		gap: 0.625rem;
	}

	.footer-mark {
		flex: none;
	}

	.footer-links {
		display: flex;
		gap: 1.375rem;
	}

	.footer-links a {
		color: inherit;
		text-decoration: none;
	}

	.footer-links a:hover {
		color: var(--serv-ink);
	}
</style>
