								<circle cx="-12.4" cy="4.0" r="1.8" fill="#0e1424"></circle>
								<circle cx="-7.6" cy="-10.5" r="1.8" fill="#0e1424"></circle>
								<g stroke="#ffffff" stroke-width="2.2">
									<line x1="0.0" y1="-9.5" x2="0.0" y2="-25.5"></line>
									<line x1="5.6" y1="-7.7" x2="15.0" y2="-20.6"></line>
									<line x1="9.0" y1="-2.9" x2="24.3" y2="-7.9"></line>
									<line x1="9.0" y1="2.9" x2="24.3" y2="7.9"></line>
									<line x1="5.6" y1="7.7" x2="15.0" y2="20.6"></line>
									<line x1="0.0" y1="9.5" x2="0.0" y2="25.5"></line>
									<line x1="-5.6" y1="7.7" x2="-15.0" y2="20.6"></line>
									<line x1="-9.0" y1="2.9" x2="-24.3" y2="7.9"></line>
									<line x1="-9.0" y1="-2.9" x2="-24.3" y2="-7.9"></line>
									<line x1="-5.6" y1="-7.7" x2="-15.0" y2="-20.6"></line>
								</g>
							</g>
						</defs>
						<g stroke="#3d4870" stroke-width="1">
							<line x1="34" y1="60" x2="34" y2="240"></line>
							<line x1="628" y1="60" x2="628" y2="240"></line>
