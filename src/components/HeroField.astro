						<g style="transform-box:view-box; transform-origin:470px 185px; animation:spin 3.2s linear infinite;"><use href="#1d-wd" transform="translate(470 185)"></use></g>
					</svg>
				</div>

				<div class="hero-field__car hero-field__car--c">
					<svg viewBox="0 0 660 268" width="100%" role="img" aria-label="Stylized car illustration">
						<defs>
							<g id="1b-wb">
								<circle r="44" fill="none" stroke="#ffffff" stroke-width="9"></circle>
								<circle r="34" fill="none" stroke="#ffffff" stroke-width="1.6" opacity="0.7"></circle>
								<circle r="27" fill="none" stroke="#ffffff" stroke-width="3"></circle>
								<circle r="9.5" fill="#ffffff"></circle>
