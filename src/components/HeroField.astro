</div>

<style>
	.hero-field {
		position: absolute;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
	}

	.hero-field__dots {
		position: absolute;
		inset: 0;
		background-image: radial-gradient(circle, rgb(246 245 242 / 14%) 1.5px, transparent 1.6px);
		background-size: 22px 22px;
	}

	.hero-field__dots--sweep {
		background-image: radial-gradient(circle, rgb(58 95 192 / 85%) 2.2px, transparent 2.3px);
		-webkit-mask-image: linear-gradient(90deg, transparent, #000 18%, #000 82%, transparent);
		mask-image: linear-gradient(90deg, transparent, #000 18%, #000 82%, transparent);
		-webkit-mask-size: 55% 100%;
		mask-size: 55% 100%;
		-webkit-mask-repeat: no-repeat;
		mask-repeat: no-repeat;
		animation: servSweep 12s ease-in-out infinite;
		animation-play-state: var(--serv-play, running);
	}

	.hero-field__vignette {
		position: absolute;
		inset: 0;
	}

	.hero-field--home .hero-field__vignette {
		background: radial-gradient(
			115% 90% at 22% 45%,
			var(--serv-ink) 38%,
			rgb(13 18 25 / 72%) 68%,
			rgb(13 18 25 / 25%) 100%
		);
	}

	.hero-field--product .hero-field__vignette {
		background: radial-gradient(
			110% 90% at 18% 40%,
			var(--serv-ink) 42%,
			rgb(13 18 25 / 78%) 72%,
			rgb(13 18 25 / 40%) 100%
		);
	}

	.hero-field__road {
		position: absolute;
		inset: 0;
	}

	/* Three stacked lanes, each with its own road line and car, replacing
	   the single road/car pair. Line-to-car vertical offset (8px) matches
	   the original single-lane relationship. */
	.hero-field__road-line {
		position: absolute;
		left: 0;
		right: 0;
		height: 1px;
		background: var(--serv-border-on-dark);
	}

	.hero-field__road-line--a {
		bottom: 22px;
	}

	.hero-field__road-line--b {
		bottom: 78px;
	}

	.hero-field__road-line--c {
		bottom: 134px;
	}

	.hero-field__car {
		position: absolute;
		left: -16%;
		width: 96px;
		animation-name: servDriveR;
		animation-timing-function: linear;
		animation-iteration-count: infinite;
		animation-play-state: var(--serv-play, running);
	}

	.hero-field__car--a {
		bottom: 14px;
		animation-duration: 13s;
		animation-delay: 0s;
	}

	.hero-field__car--b {
		bottom: 70px;
		animation-duration: 15s;
		animation-delay: -5s;
	}

	.hero-field__car--c {
		bottom: 126px;
		animation-duration: 17s;
		animation-delay: -10s;
	}

	@media (min-width: 640px) {
		.hero-field__car {
			width: 120px;
		}
	}

	/* The car crosses the same 132%-of-viewport-width distance regardless of
	   screen size, so on a narrow phone screen it covers far fewer of its own
	   body-lengths per second than on desktop and reads as crawling rather
	   than driving. Shorten the crossing below the breakpoint where the cars
	   are already at their smaller 96px size, keeping each lane's relative
	   pacing. Placed after the base rules above so it wins the cascade
	   despite matching them on specificity. */
	@media (max-width: 639px) {
		.hero-field__car--a {
			animation-duration: 4.5s;
		}

		.hero-field__car--b {
			animation-duration: 5.2s;
		}

		.hero-field__car--c {
			animation-duration: 5.9s;
		}
	}
</style>
