---
// Dark-ink hero background: dot grid + radial vignette, with an optional
// sweeping accent-dot layer and a car crossing the bottom edge. Mirrors the
// approved "SERV Results Final" mockup's Home (variant="home", withCar) and
// Auto Insights (variant="product") heroes. Render as the first child of a
// `position: relative; overflow: hidden;` hero section.
interface Props {
	variant?: 'home' | 'product';
	withCar?: boolean;
}

const { variant = 'home', withCar = false } = Astro.props;
---

<div class:list={['hero-field', `hero-field--${variant}`]} aria-hidden="true">
	<div class="hero-field__dots"></div>
	{variant === 'home' && <div class="hero-field__dots hero-field__dots--sweep"></div>}
	<div class="hero-field__vignette"></div>
	{
		withCar && (
			<div class="hero-field__road">
				<div class="hero-field__road-line hero-field__road-line--a"></div>
				<div class="hero-field__road-line hero-field__road-line--b"></div>

				<div class="hero-field__car hero-field__car--a1">
					<svg viewBox="0 0 660 268" width="100%" role="img" aria-label="Stylized car illustration">
						<defs>
							<g id="1b-wb-a1">
								<circle r="44" fill="#0e1424"></circle>
								<circle r="28" fill="#ffffff"></circle>
								<circle r="28" fill="none" stroke="#3a5fc0" stroke-width="3.5"></circle>
								<g stroke="#0e1424" stroke-width="5" stroke-linecap="round">
									<line x1="0" y1="-26" x2="0" y2="26"></line>
									<line x1="-26" y1="0" x2="26" y2="0"></line>
								</g>
								<circle r="6.5" fill="#3a5fc0"></circle>
							</g>
						</defs>
						<path
							d="M 40 195 L 34 168 C 34 150 44 138 62 134 L 150 126 L 218 84 C 226 79 236 76 246 76 L 352 76 C 372 76 390 84 404 98 L 448 122 L 566 138 C 596 143 616 152 622 166 C 628 178 626 190 618 196 L 525 198 A 55 55 0 0 0 415 198 L 225 198 A 55 55 0 0 0 115 198 Z"
							fill="#3a5fc0"
							transform="translate(10 10)"
						></path>
						<g style="transform-box:view-box; transform-origin:center; animation:floatY 5s ease-in-out infinite;">
							<path
								d="M 40 195 L 34 168 C 34 150 44 138 62 134 L 150 126 L 218 84 C 226 79 236 76 246 76 L 352 76 C 372 76 390 84 404 98 L 448 122 L 566 138 C 596 143 616 152 622 166 C 628 178 626 190 618 196 L 525 198 A 55 55 0 0 0 415 198 L 225 198 A 55 55 0 0 0 115 198 Z"
								fill="#ffffff"
							></path>
							<path
								d="M 256 90 L 340 90 L 340 122 L 240 122 Z M 352 90 L 420 122 L 352 122 Z M 234 96 L 234 122 L 182 122 Z"
								fill="#171f36"
							></path>
							<path d="M 36 146 L 54 143 L 54 158 L 36 158 Z M 592 148 L 620 159 L 617 172 L 590 165 Z" fill="#0e1424"></path>
							<path d="M 278 142 h 32 v 8 h -32 z M 374 142 h 32 v 8 h -32 z" fill="#0e1424"></path>
							<path d="M 62 152 L 300 148 L 566 150 M 250 126 L 250 196 M 344 126 L 348 196" fill="none" stroke="#0e1424" stroke-width="1.8" opacity="0.4"></path>
							<rect x="120" y="180" width="400" height="7" fill="#3a5fc0"></rect>
						</g>
						<g style="transform-box:fill-box; transform-origin:center; animation:spin 3.2s linear infinite;"><use href="#1b-wb-a1" transform="translate(170 185)"></use></g>
						<g style="transform-box:fill-box; transform-origin:center; animation:spin 3.2s linear infinite;"><use href="#1b-wb-a1" transform="translate(470 185)"></use></g>
					</svg>
				</div>

				<!-- Second, smaller/dimmer car sharing the front lane - only the
				     white body-fill alpha drops (matching the reference's
				     depth technique); wheels/accents stay full-strength. -->
				<div class="hero-field__car hero-field__car--a2">
					<svg viewBox="0 0 660 268" width="100%" role="img" aria-label="Stylized car illustration">
						<defs>
							<g id="1b-wb-a2">
								<circle r="44" fill="#0e1424"></circle>
								<circle r="28" fill="#ffffff"></circle>
								<circle r="28" fill="none" stroke="#3a5fc0" stroke-width="3.5"></circle>
								<g stroke="#0e1424" stroke-width="5" stroke-linecap="round">
									<line x1="0" y1="-26" x2="0" y2="26"></line>
									<line x1="-26" y1="0" x2="26" y2="0"></line>
								</g>
								<circle r="6.5" fill="#3a5fc0"></circle>
							</g>
						</defs>
						<path
							d="M 40 195 L 34 168 C 34 150 44 138 62 134 L 150 126 L 218 84 C 226 79 236 76 246 76 L 352 76 C 372 76 390 84 404 98 L 448 122 L 566 138 C 596 143 616 152 622 166 C 628 178 626 190 618 196 L 525 198 A 55 55 0 0 0 415 198 L 225 198 A 55 55 0 0 0 115 198 Z"
							fill="#3a5fc0"
							transform="translate(10 10)"
						></path>
						<g style="transform-box:view-box; transform-origin:center; animation:floatY 5s ease-in-out infinite;">
							<path
								d="M 40 195 L 34 168 C 34 150 44 138 62 134 L 150 126 L 218 84 C 226 79 236 76 246 76 L 352 76 C 372 76 390 84 404 98 L 448 122 L 566 138 C 596 143 616 152 622 166 C 628 178 626 190 618 196 L 525 198 A 55 55 0 0 0 415 198 L 225 198 A 55 55 0 0 0 115 198 Z"
								fill="rgba(255,255,255,0.72)"
							></path>
							<path
								d="M 256 90 L 340 90 L 340 122 L 240 122 Z M 352 90 L 420 122 L 352 122 Z M 234 96 L 234 122 L 182 122 Z"
								fill="#171f36"
							></path>
							<path d="M 36 146 L 54 143 L 54 158 L 36 158 Z M 592 148 L 620 159 L 617 172 L 590 165 Z" fill="#0e1424"></path>
							<path d="M 278 142 h 32 v 8 h -32 z M 374 142 h 32 v 8 h -32 z" fill="#0e1424"></path>
							<path d="M 62 152 L 300 148 L 566 150 M 250 126 L 250 196 M 344 126 L 348 196" fill="none" stroke="#0e1424" stroke-width="1.8" opacity="0.4"></path>
							<rect x="120" y="180" width="400" height="7" fill="#3a5fc0"></rect>
						</g>
						<g style="transform-box:fill-box; transform-origin:center; animation:spin 3.2s linear infinite;"><use href="#1b-wb-a2" transform="translate(170 185)"></use></g>
						<g style="transform-box:fill-box; transform-origin:center; animation:spin 3.2s linear infinite;"><use href="#1b-wb-a2" transform="translate(470 185)"></use></g>
					</svg>
				</div>

				<!-- Sole car on the back lane - smaller and dimmer again than
				     the a2 car above, continuing the same depth progression. -->
				<div class="hero-field__car hero-field__car--b">
					<svg viewBox="0 0 660 268" width="100%" role="img" aria-label="Stylized car illustration">
						<defs>
							<g id="1b-wb-b">
								<circle r="44" fill="#0e1424"></circle>
								<circle r="28" fill="#ffffff"></circle>
								<circle r="28" fill="none" stroke="#3a5fc0" stroke-width="3.5"></circle>
								<g stroke="#0e1424" stroke-width="5" stroke-linecap="round">
									<line x1="0" y1="-26" x2="0" y2="26"></line>
									<line x1="-26" y1="0" x2="26" y2="0"></line>
								</g>
								<circle r="6.5" fill="#3a5fc0"></circle>
							</g>
						</defs>
						<path
							d="M 40 195 L 34 168 C 34 150 44 138 62 134 L 150 126 L 218 84 C 226 79 236 76 246 76 L 352 76 C 372 76 390 84 404 98 L 448 122 L 566 138 C 596 143 616 152 622 166 C 628 178 626 190 618 196 L 525 198 A 55 55 0 0 0 415 198 L 225 198 A 55 55 0 0 0 115 198 Z"
							fill="#3a5fc0"
							transform="translate(10 10)"
						></path>
						<g style="transform-box:view-box; transform-origin:center; animation:floatY 5s ease-in-out infinite;">
							<path
								d="M 40 195 L 34 168 C 34 150 44 138 62 134 L 150 126 L 218 84 C 226 79 236 76 246 76 L 352 76 C 372 76 390 84 404 98 L 448 122 L 566 138 C 596 143 616 152 622 166 C 628 178 626 190 618 196 L 525 198 A 55 55 0 0 0 415 198 L 225 198 A 55 55 0 0 0 115 198 Z"
								fill="rgba(255,255,255,0.5)"
							></path>
							<path
								d="M 256 90 L 340 90 L 340 122 L 240 122 Z M 352 90 L 420 122 L 352 122 Z M 234 96 L 234 122 L 182 122 Z"
								fill="#171f36"
							></path>
							<path d="M 36 146 L 54 143 L 54 158 L 36 158 Z M 592 148 L 620 159 L 617 172 L 590 165 Z" fill="#0e1424"></path>
							<path d="M 278 142 h 32 v 8 h -32 z M 374 142 h 32 v 8 h -32 z" fill="#0e1424"></path>
							<path d="M 62 152 L 300 148 L 566 150 M 250 126 L 250 196 M 344 126 L 348 196" fill="none" stroke="#0e1424" stroke-width="1.8" opacity="0.4"></path>
							<rect x="120" y="180" width="400" height="7" fill="#3a5fc0"></rect>
						</g>
						<g style="transform-box:fill-box; transform-origin:center; animation:spin 3.2s linear infinite;"><use href="#1b-wb-b" transform="translate(170 185)"></use></g>
						<g style="transform-box:fill-box; transform-origin:center; animation:spin 3.2s linear infinite;"><use href="#1b-wb-b" transform="translate(470 185)"></use></g>
					</svg>
				</div>
			</div>
		)
	}
</div>

<style>
	.hero-field {
		position: absolute;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
	}

	.hero-field__dots {
		position: absolute;
		inset: 0;
		background-image: radial-gradient(circle, rgb(246 245 242 / 14%) 1.5px, transparent 1.6px);
		background-size: 22px 22px;
	}

	.hero-field__dots--sweep {
		background-image: radial-gradient(circle, rgb(58 95 192 / 85%) 2.2px, transparent 2.3px);
		-webkit-mask-image: linear-gradient(90deg, transparent, #000 18%, #000 82%, transparent);
		mask-image: linear-gradient(90deg, transparent, #000 18%, #000 82%, transparent);
		-webkit-mask-size: 55% 100%;
		mask-size: 55% 100%;
		-webkit-mask-repeat: no-repeat;
		mask-repeat: no-repeat;
		animation: servSweep 12s ease-in-out infinite;
		animation-play-state: var(--serv-play, running);
	}

	.hero-field__vignette {
		position: absolute;
		inset: 0;
	}

	.hero-field--home .hero-field__vignette {
		background: radial-gradient(
			115% 90% at 22% 45%,
			var(--serv-ink) 38%,
			rgb(13 18 25 / 72%) 68%,
			rgb(13 18 25 / 25%) 100%
		);
	}

	.hero-field--product .hero-field__vignette {
		background: radial-gradient(
			110% 90% at 18% 40%,
			var(--serv-ink) 42%,
			rgb(13 18 25 / 78%) 72%,
			rgb(13 18 25 / 40%) 100%
		);
	}

	.hero-field__road {
		position: absolute;
		inset: 0;
	}

	/* Two stacked lanes. The front lane (a) carries two cars - a1 full-size/
	   full-strength, a2 a little smaller and dimmer to read as slightly
	   further back in the same lane. The back lane (b) carries one car,
	   smaller and dimmer again than a2, continuing the same depth step.
	   Line-to-car vertical offset (8px) matches the original single-lane
	   relationship. Sizing/dimming ratios follow the reference mockup
	   (SERV Results Hero 5c). */
	.hero-field__road-line {
		position: absolute;
		left: 0;
		right: 0;
		height: 1px;
		background: var(--serv-border-on-dark);
	}

	.hero-field__road-line--a {
		bottom: 22px;
	}

	.hero-field__road-line--b {
		bottom: 78px;
	}

	.hero-field__car {
		position: absolute;
		left: -16%;
		width: 96px;
		animation-name: servDriveR;
		animation-timing-function: linear;
		animation-iteration-count: infinite;
		animation-play-state: var(--serv-play, running);
	}

	.hero-field__car--a1 {
		bottom: 14px;
		animation-duration: 13s;
		animation-delay: 0s;
	}

	.hero-field__car--a2 {
		bottom: 12px;
		width: 79px;
		animation-duration: 16s;
		animation-delay: -6s;
	}

	.hero-field__car--b {
		bottom: 70px;
		width: 60px;
		animation-duration: 19s;
		animation-delay: -9s;
	}

	@media (min-width: 640px) {
		.hero-field__car {
			width: 120px;
		}

		.hero-field__car--a2 {
			width: 98px;
		}

		.hero-field__car--b {
			width: 74px;
		}
	}

	/* The car crosses the same 132%-of-viewport-width distance regardless of
	   screen size, so on a narrow phone screen it covers far fewer of its own
	   body-lengths per second than on desktop and reads as crawling rather
	   than driving. Shorten the crossing below the breakpoint where the cars
	   are already at their smaller size, keeping each lane's relative
	   pacing. Placed after the base rules above so it wins the cascade
	   despite matching them on specificity. */
	@media (max-width: 639px) {
		.hero-field__car--a1 {
			animation-duration: 4.5s;
		}

		.hero-field__car--a2 {
			animation-duration: 5.5s;
		}

		.hero-field__car--b {
			animation-duration: 6.5s;
		}
	}
</style>
