							fill="url(#1d-patHatch)"
						></path>
						<path
							d="M 40 195 L 34 168 C 34 150 44 138 62 134 L 150 126 L 218 84 C 226 79 236 76 246 76 L 352 76 C 372 76 390 84 404 98 L 448 122 L 566 138 C 596 143 616 152 622 166 C 628 178 626 190 618 196 L 525 198 A 55 55 0 0 0 415 198 L 225 198 A 55 55 0 0 0 115 198 Z"
							fill="none"
							stroke="#ffffff"
							stroke-width="3.5"
							stroke-linejoin="round"
						></path>
						<path
							d="M 256 90 L 340 90 L 340 122 L 240 122 Z M 352 90 L 420 122 L 352 122 Z M 234 96 L 234 122 L 182 122 Z"
							fill="#171f36"
							stroke="#ffffff"
							stroke-width="2.5"
							stroke-linejoin="round"
						></path>
						<path
							d="M 62 152 L 300 148 L 566 150 M 250 126 L 250 196 M 344 126 L 348 196 M 448 124 L 452 138"
							fill="none"
							stroke="#ffffff"
							stroke-width="1.8"
						></path>
						<path d="M 36 146 L 54 143 L 54 158 L 36 158 Z M 592 148 L 620 159 L 617 172 L 590 165 Z" fill="#0e1424" stroke="#ffffff" stroke-width="2.5"></path>
						<path d="M 278 142 h 32 v 8 h -32 z M 374 142 h 32 v 8 h -32 z" fill="#ffffff"></path>
