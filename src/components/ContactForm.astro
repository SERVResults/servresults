---
---

<form id="contact-form" class="contact-form" novalidate>
	<div class="field">
		<label for="name">Name</label>
		<input id="name" name="name" type="text" autocomplete="name" required />
	</div>

	<div class="field">
		<label for="email">Email</label>
		<input id="email" name="email" type="email" autocomplete="email" required />
	</div>

	<div class="field">
		<label for="dealershipName">Dealership Name</label>
		<input id="dealershipName" name="dealershipName" type="text" autocomplete="organization" required />
	</div>

	<div class="field">
		<label for="message">Message</label>
		<textarea id="message" name="message" rows="3" required></textarea>
	</div>

	<div class="field field--honeypot" aria-hidden="true">
		<label for="honeypot">Leave this field empty</label>
		<input id="honeypot" name="honeypot" type="text" tabindex="-1" autocomplete="off" />
	</div>

	<button type="submit" class="btn btn-primary">Send</button>

	<p id="contact-form-status" role="status" aria-live="polite"></p>
</form>

<style>
	.contact-form {
		display: flex;
		flex-direction: column;
		gap: 0.875rem;
	}

	.field {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.field--honeypot {
		position: absolute;
		left: -9999px;
		width: 1px;
		height: 1px;
		overflow: hidden;
	}

	label {
		font-size: 0.9rem;
		font-weight: 600;
	}

	input,
	textarea {
		font: inherit;
		padding: 0.65rem 0.85rem;
		border: 1px solid var(--serv-border-on-light-strong);
		border-radius: 0;
		color: var(--serv-text-on-light);
		background: var(--serv-white);
	}

	input:focus,
	textarea:focus {
		outline: 2px solid var(--serv-primary);
		outline-offset: 1px;
	}

	button {
		align-self: flex-start;
	}

	@media (max-height: 760px) {
		.contact-form {
			gap: 0.625rem;
		}

		.field {
			gap: 0.2rem;
		}

		input,
		textarea {
			padding: 0.4rem 0.75rem;
		}

		textarea {
			height: 2.75rem;
		}

		button {
			padding: 0.5rem 1.5rem;
		}
	}

	#contact-form-status {
		position: fixed;
		left: 50%;
		bottom: 1.5rem;
		z-index: 1000;
		max-width: min(90vw, 380px);
		margin: 0;
		padding: 0.85rem 1.5rem;
		background: var(--serv-white);
		border: 1px solid var(--serv-border-on-light-strong);
		box-shadow: 0 8px 24px rgb(13 18 25 / 14%);
		font-size: 0.9rem;
		font-weight: 600;
		text-align: center;
		color: var(--serv-text-on-light);
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transform: translate(-50%, 0.5rem);
		transition:
			opacity 0.2s ease,
			transform 0.2s ease,
			visibility 0.2s;
	}

	#contact-form-status.is-visible {
		opacity: 1;
		visibility: visible;
		pointer-events: auto;
		transform: translate(-50%, 0);
	}

	#contact-form-status[data-state='success'] {
		border-color: #1a7f37;
		color: #1a7f37;
	}

	#contact-form-status[data-state='error'] {
		border-color: #c0342c;
		color: #c0342c;
	}
</style>

<script>
	import { submitContactForm } from '../lib/submitContactForm';

	const form = document.getElementById('contact-form') as HTMLFormElement | null;
	const status = document.getElementById('contact-form-status');
	let hideTimer: ReturnType<typeof setTimeout> | undefined;

	function showToast(state: 'success' | 'error' | '', message: string, autoHide = false) {
		if (!status) return;
		clearTimeout(hideTimer);
		status.dataset.state = state;
		status.textContent = message;
		status.classList.add('is-visible');
		if (autoHide) {
			hideTimer = setTimeout(() => status.classList.remove('is-visible'), 5000);
		}
	}

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		if (!status) return;

		const data = new FormData(form);
		const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
		submitButton?.setAttribute('disabled', 'true');
		showToast('', 'Sending...');

		const result = await submitContactForm({
			name: String(data.get('name') ?? ''),
			email: String(data.get('email') ?? ''),
			dealershipName: String(data.get('dealershipName') ?? ''),
			message: String(data.get('message') ?? ''),
			honeypot: String(data.get('honeypot') ?? ''),
		});

		submitButton?.removeAttribute('disabled');

		if (result.ok) {
			showToast('success', "Thanks - we'll be in touch shortly.", true);
			form.reset();
		} else {
			showToast('error', result.error ?? 'Something went wrong. Please try again.', true);
		}
	});
</script>
