# Storyblok Content Delivery API token (Space Settings > Access Tokens).
# Use the "Public" token for production, "Preview" token for draft content in dev.
STORYBLOK_TOKEN=

# Contact form email provider — fill in once decided (Resend, Formspree, or EmailJS).
# See src/lib/submitContactForm.ts for the single integration point.
# RESEND_API_KEY=
# FORMSPREE_FORM_ID=
# EMAILJS_PUBLIC_KEY=
# EMAILJS_SERVICE_ID=
# EMAILJS_TEMPLATE_ID=
