# Storyblok Content Delivery API token (Space Settings > Access Tokens).
# Use the "Public" token for production, "Preview" token for draft content in dev.
STORYBLOK_TOKEN=

# Contact form email: sent via a standalone Lambda function (functions/contact-form)
# that calls Resend server-side. This is the function's public Function URL —
# see functions/contact-form/README.md to deploy it and get this value.
# Must be prefixed PUBLIC_ since it's read client-side by src/lib/submitContactForm.ts.
PUBLIC_CONTACT_FUNCTION_URL=
