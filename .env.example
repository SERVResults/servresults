# Storyblok Content Delivery API token (Space Settings > Access Tokens).
# Use the "Public" token for production, "Preview" token for draft content in dev.
STORYBLOK_TOKEN=

# Contact form email: sent via a standalone Lambda function (functions/contact-form)
# that calls Amazon SES server-side, authenticated via the function's own IAM role
# (no API key). This is the function's public Function URL — see
# functions/contact-form/README.md to deploy it and get this value.
# Must be prefixed PUBLIC_ since it's read client-side by src/lib/submitContactForm.ts.
PUBLIC_CONTACT_FUNCTION_URL=

# The two variables below are NOT read by this Astro site — they configure the
# Lambda function itself (functions/contact-form), set via
# `aws lambda create-function --environment` / `update-function-configuration`.
# Documented here so all the config this feature needs lives in one place.
# FROM_EMAIL='SERV Results Website <noreply@servresults.com>'
# TO_EMAILS=info@servresults.com
